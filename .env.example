# Copy to .env.local and fill in. Never commit real values.

# --- Database -------------------------------------------------------------
# Neon dev branch (recommended). From the Vercel Marketplace Neon integration,
# `vercel env pull .env.local` fills this in. Use the pooled connection string.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used by drizzle-kit for migrations. Same as above
# without "-pooler" in the host. Optional: falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Or local Docker Postgres (`pnpm db:up`):
# DATABASE_URL=postgres://football:football@localhost:5432/football

# --- Admin (prototype auth, used from Milestone 4) --------------------------
# Single admin password; at least 8 characters.
ADMIN_PASSWORD=change-me-please
# Secret for signing the session cookie; at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# --- Public ----------------------------------------------------------------
# Product name shown in the UI (not decided yet, so never hard-coded).
NEXT_PUBLIC_APP_NAME=Grassroots Football
# Absolute site URL for share links and Open Graph images. On Vercel this falls
# back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
