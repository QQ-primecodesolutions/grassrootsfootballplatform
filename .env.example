# Copy to .env.local and fill in. Never commit real values.

# --- Database -------------------------------------------------------------
# Neon dev branch (recommended): the branch's POOLED connection string (host has "-pooler").
# Never put production values in this file or in .env.production.local (see README).
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon only: the DIRECT connection string (same host without "-pooler"), used by
# drizzle-kit for migrations. Uncomment and fill in. When unset, DATABASE_URL is used.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Or local Docker Postgres (`pnpm db:up`):
# DATABASE_URL=postgres://football:football@localhost:5432/football

# --- Admin ------------------------------------------------------------------
# Everyone signs in with their own account (create yours: pnpm admin:super, see README).
# Secret for signing the session cookie; at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# --- Public ----------------------------------------------------------------
# Product name shown in the UI (not decided yet, so never hard-coded).
NEXT_PUBLIC_APP_NAME=Grassroots Football
# Absolute site URL for share links and Open Graph images. On Vercel this falls
# back to the production domain when unset; preview deployments use their own URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact for privacy questions (shown on /privacy). Until set, /privacy is only a draft
# (visible in development, hidden in production) and the footer has no Privacy link.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.co.za
